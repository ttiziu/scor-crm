// SCOR CRM - Multi-tenant. Conexión a Supabase (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---
enum Role {
  ADMIN
  OPERADOR
  REPARTIDOR
}

enum FormaPago {
  YAPE
  PLIN
  TRANSFERENCIA
  EFECTIVO
  TARJETA
}

enum PedidoEstado {
  CREATED
  IN_ROUTE
  DELIVERED
  CANCELLED
}

// --- Modelos ---
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  clientes  Cliente[]
  pedidos   Pedido[]
  productos Producto[]
  marcas    Marca[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String?
  email        String?
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pedidosAsignados Pedido[] @relation("RepartidorPedidos")

  @@unique([tenantId, username])
  @@index([tenantId])
}

model Cliente {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  documento   String?
  direccion   String?
  distrito    String?
  tipoValvula String?
  telefono    String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  direcciones ClienteDireccion[]
  pedidos     Pedido[]

  @@index([tenantId])
}

model ClienteDireccion {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre      String
  direccion   String
  distrito    String?
  tipoValvula String?

  pedidos Pedido[]

  @@index([clienteId])
}

model Producto {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  pedidoItems PedidoItem[]

  @@index([tenantId])
}

model Marca {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidoItems PedidoItem[]

  @@index([tenantId])
}

model Pedido {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId           String
  cliente             Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteDireccionId  String?
  clienteDireccion    ClienteDireccion? @relation(fields: [clienteDireccionId], references: [id], onDelete: SetNull)
  estado              PedidoEstado      @default(CREATED)
  cantidad          Int?
  fechaPedido       DateTime     @default(now())
  fechaProgramada   DateTime?
  repartidorId      String?
  repartidor        User?        @relation("RepartidorPedidos", fields: [repartidorId], references: [id], onDelete: SetNull)
  asignadoEn        DateTime?    // hora en que se asignó al repartidor
  formaPago         FormaPago?
  efectivoCon       Decimal?      @db.Decimal(10, 2)
  motivoCancelacion String?
  observaciones     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  items PedidoItem[]

  @@index([tenantId])
  @@index([clienteId])
  @@index([clienteDireccionId])
  @@index([repartidorId])
}

model PedidoItem {
  id             String   @id @default(cuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  marcaId        String?
  marca          Marca?   @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)

  @@index([pedidoId])
  @@index([productoId])
  @@index([marcaId])
}
