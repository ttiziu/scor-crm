// SCOR CRM - Multi-tenant. Conexión a Supabase (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---
enum Role {
  ADMIN
  OPERADOR
}

enum PedidoEstado {
  CREATED
  IN_ROUTE
  DELIVERED
  CANCELLED
}

// --- Modelos ---
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  clientes Cliente[]
  pedidos  Pedido[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Cliente {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  documento String?
  direccion String?
  telefono  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidos Pedido[]

  @@index([tenantId])
}

model Pedido {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId    String
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estado       PedidoEstado @default(CREATED)
  cantidad     Int?
  fechaPedido  DateTime     @default(now())
  observaciones String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
  @@index([clienteId])
}
